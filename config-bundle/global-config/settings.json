{
  "model": "sonnet",
  "maxTokens": 8192,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statuslines/model-display.sh",
    "padding": 1
  },
  "permissions": {
    "allowedTools": ["Read", "Write", "Bash"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.key)",
      "Write(./production.*)",
      "Write(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/file-trigger-matcher.js"
          }
        ]
      }
    ]
  }
}
