{
  "name": "claude-code-helper",
  "version": "2.8.0",
  "private": true,
  "description": "Comprehensive toolkit and learning resource for mastering Claude Code",
  "workspaces": [
    "mcp-servers/mcp-shared",
    "mcp-servers/api-specialist-mcp",
    "mcp-servers/code-review-mcp",
    "mcp-servers/design-system-mcp",
    "mcp-servers/testing-mcp",
    "mcp-servers/uiux-review-mcp",
    "mcp-servers/cicd-pipeline",
    "mcp-servers/database-operations",
    "mcp-servers/dependency-management",
    "mcp-servers/n8n-automation",
    "mcp-servers/rag-mcp",
    "mcp-servers/project-oversight-mcp",
    "trigger-matcher"
  ],
  "scripts": {
    "lint": "eslint .",
    "validate": "node scripts/validate-frontmatter.mjs",
    "build-shared": "npm run build -w mcp-shared",
    "build:mcp": "npm run build-shared && npm run build --workspaces --if-present",
    "test:trigger-matcher": "npm test -w claude-trigger-matcher",
    "test:mcp-shared": "npm test -w mcp-shared",
    "test:all": "npm run build:shared && npm test --workspaces --if-present",
    "generate:versions": "node scripts/generate-version-index.mjs",
    "test:scripts": "node --test scripts/__tests__/generate-version-index.test.mjs && bash scripts/__tests__/manifest-helper.test.sh && bash scripts/__tests__/update-component.test.sh",
    "dashboard": "npm run build -w project-oversight-mcp && npm run dashboard -w project-oversight-mcp",
    "benchmark": "node scripts/benchmark-startup.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "mcp-servers/*/src/**/*.ts": [
      "eslint --no-warn-ignored --max-warnings 0"
    ],
    "trigger-matcher/src/**/*.ts": [
      "eslint --no-warn-ignored --max-warnings 0"
    ]
  },
  "license": "Apache-2.0",
  "author": "Michel Abboud"
}
