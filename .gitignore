# Node modules (all subdirectories)
**/node_modules/
**/package-lock.json

# Python virtual environments (all subdirectories)
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/

# Build outputs (all subdirectories)
**/build/
**/dist/
**/*.js.map
**/.cache/

# Environment files
.env
.env.local
.env.*.local

# API keys and secrets
**/secrets/
**/*secret*
**/*.key
**/*.pem

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store
mcp-servers/claude_desktop_config.json

# Demo folder (for testing triggers)
demo/*
!demo/.gitkeep
!demo/APP-REQUIREMENTS.md
!demo/IMPLEMENTATION-PLAN.md
!demo/package.json
!demo/tsconfig.json
!demo/.env.example
!demo/postcss.config.js
!demo/tailwind.config.ts
!demo/vitest.config.ts
!demo/playwright.config.ts
!demo/prisma/
!demo/src/
