{
  "name": "file-trigger-hook",
  "description": "Intercepts Read/Edit/Write operations to match against agent file triggers",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/file-trigger-matcher.js read \"$FILE_PATH\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/file-trigger-matcher.js edit \"$FILE_PATH\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/file-trigger-matcher.js write \"$FILE_PATH\""
          }
        ]
      }
    ]
  }
}
