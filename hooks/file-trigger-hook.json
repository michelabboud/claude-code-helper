{
  "name": "file-trigger-hook",
  "description": "Intercepts Read/Edit/Write/NotebookEdit operations to match against agent file triggers",
  "version": "1.0.0",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_PATH=$HOME/.claude/hooks/node_modules node $HOME/.claude/hooks/file-trigger-matcher.js"
          }
        ]
      }
    ]
  }
}
