{
  "name": "cicd-pipeline-mcp",
  "version": "1.0.0",
  "description": "MCP server for CI/CD pipeline generation, optimization, and troubleshooting",
  "type": "module",
  "bin": {
    "cicd-pipeline-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "keywords": [
    "mcp",
    "ci",
    "cd",
    "github-actions",
    "gitlab-ci",
    "jenkins",
    "circleci",
    "devops"
  ],
  "author": "Claude Code Helper",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
