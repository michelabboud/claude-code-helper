{
  "name": "cicd-pipeline-mcp",
  "version": "1.0.1",
  "description": "MCP server for CI/CD pipeline generation, optimization, and troubleshooting",
  "type": "module",
  "bin": {
    "cicd-pipeline-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "keywords": [
    "mcp",
    "ci",
    "cd",
    "github-actions",
    "gitlab-ci",
    "jenkins",
    "circleci",
    "devops"
  ],
  "author": "Claude Code Helper",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "mcp-shared": "*",
    "zod": "^3.23.8",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.2",
    "@types/js-yaml": "^4.0.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
