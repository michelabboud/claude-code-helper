{
  "name": "testing-mcp",
  "version": "1.0.1",
  "description": "MCP server for test execution, coverage analysis, and test quality metrics",
  "type": "module",
  "bin": {
    "testing-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "keywords": ["mcp", "testing", "coverage", "quality"],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "mcp-shared": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.2"
  }
}
