# ============================================================================#
# RAG MCP Server Configuration Template
# ============================================================================#
# Copy this file to .env and customize for your environment

# ----------------------------------------------------------------------------
# Vector Database Selection
# ----------------------------------------------------------------------------
# Choose your vector database backend
# Options: chromadb | redis | qdrant
# Default: chromadb
VECTOR_DB_TYPE=redis

# Database Connection Settings
# ChromaDB: localhost:8000
# Redis: localhost:6379
# Qdrant: localhost:6333
REDIS_HOST=localhost
REDIS_PORT=6379
# QDRANT_URL=http://localhost:6333

# ----------------------------------------------------------------------------
# Embedding Model Configuration (Redis & Qdrant only)
# ----------------------------------------------------------------------------
# ChromaDB auto-generates embeddings.
# For Redis & Qdrant, choose your embedding provider and model variant.

# Embedding Provider
# Options: local | openai
# Default: local (free, runs on your machine)
EMBEDDING_TYPE=local

# Model Variant (local embeddings only)
# Options: default | quantized
#
# default   - Full precision (90.4 MB, best accuracy)
# quantized - INT8 quantized (23 MB, 75% smaller, ~99% accuracy)
#
# Default: default
MODEL_VARIANT=default

# OpenAI Configuration (only if EMBEDDING_TYPE=openai)
# OPENAI_API_KEY=sk-...

# ----------------------------------------------------------------------------
# Choosing a Model Variant
# ----------------------------------------------------------------------------
# Use DEFAULT when:
#   • Building production systems
#   • Maximum accuracy is critical
#   • Storage/bandwidth is not constrained
#
# Use QUANTIZED when:
#   • Developing locally
#   • Running in CI/CD pipelines
#   • Storage or bandwidth is limited
#   • Fast setup is important (3s vs 10s first download)
#
# Both produce 384-dimensional embeddings and work identically in the API.
# See MODEL-VARIANTS.md for detailed comparison.

# ----------------------------------------------------------------------------
# Example Configurations
# ----------------------------------------------------------------------------

# Production (full precision for best quality):
# VECTOR_DB_TYPE=redis
# EMBEDDING_TYPE=local
# MODEL_VARIANT=default

# Development (quantized for fast setup):
# VECTOR_DB_TYPE=redis
# EMBEDDING_TYPE=local
# MODEL_VARIANT=quantized

# OpenAI embeddings (requires API key):
# VECTOR_DB_TYPE=redis
# EMBEDDING_TYPE=openai
# OPENAI_API_KEY=sk-...
