# RAG MCP Server Configuration

# =============================================================================
# VECTOR DATABASE SELECTION
# =============================================================================

# Which vector database to use
# Options: chromadb (default), redis, qdrant
VECTOR_DB_TYPE=chromadb

# Database connection (auto-configured based on VECTOR_DB_TYPE)
# VECTOR_DB_HOST=localhost
# VECTOR_DB_PORT=8000    # ChromaDB: 8000, Redis: 6379, Qdrant: 6333

# =============================================================================
# EMBEDDING GENERATION (Redis and Qdrant only)
# =============================================================================

# Which embedding model to use (ignored for ChromaDB)
# Options: local (default), openai
EMBEDDING_TYPE=local

# OpenAI API Key (required if EMBEDDING_TYPE=openai)
# OPENAI_API_KEY=sk-proj-...
