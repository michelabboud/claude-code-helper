{
  "name": "api-specialist-mcp",
  "version": "1.0.0",
  "description": "MCP server for comprehensive API testing, validation, security checks, and improvement suggestions",
  "type": "module",
  "bin": {
    "api-specialist-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "keywords": ["mcp", "api", "testing", "validation", "security", "openapi", "swagger"],
  "author": "Claude Code Helper",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "js-yaml": "^4.1.0",
    "mcp-shared": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.2"
  }
}
